# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biasgame
POSTGRES_USER=biasgame
POSTGRES_PASSWORD=biasgame

# CORS (Client-URL für lokale Entwicklung)
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change_me_in_production

# Client (Vite Build-Zeit Variable)
# Leer lassen für lokale Entwicklung (Proxy via vite.config.ts)
# Für Production: URL des Server-Services setzen (z.B. Railway)
VITE_API_URL=
